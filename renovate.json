{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "enabledManagers": ["custom.regex"],
  "packageRules": [
    {
      "description": "A major of anything here changes what the sandbox boots. List it on the dashboard, open no PR.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "libkrunfw 5.6.4 boots but breaks DNS in the VM (docs/RELEASING.md).",
      "matchPackageNames": ["containers/libkrunfw"],
      "allowedVersions": "<5.6.4"
    },
    {
      "description": "These pins are several fields at once (version, URLs that embed it, a SHA-256). Renovate cannot update them together, and a half-updated pin must never be merged, so it lists them on the dashboard for `node scripts/check-updates.mjs --apply <component>`.",
      "matchPackageNames": ["containers/libkrun", "containers/libkrunfw", "passt"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "libkrun is built from source at a tag; the build verifies the tag's commit.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["(?:\"tag\":\\s*\")(?<currentValue>v?[0-9.]+)(?:\")"],
      "depNameTemplate": "containers/libkrun",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "libkrunfw: the prebuilt guest kernel, one release asset per platform.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["(?:\"libkrunfw\":\\s*\\{\\s*\"version\":\\s*\")(?<currentValue>[^\"]+)(?:\")"],
      "depNameTemplate": "containers/libkrunfw",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "passt lives on passt.top, not GitHub; its tags are dated snapshots.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["(?:\"passt\":\\s*\\{\\s*\"version\":\\s*\")(?<currentValue>[^\"]+)(?:\")"],
      "depNameTemplate": "passt",
      "packageNameTemplate": "https://passt.top/passt",
      "datasourceTemplate": "git-tags"
    },
    {
      "description": "The Rust toolchain the native pieces are built with.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["(?:\"rust\":\\s*\")(?<currentValue>[0-9.]+)(?:\")"],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "The digest-pinned manylinux container the native build runs in.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": [
        "(?:\"buildImage\":\\s*\"(?<depName>quay\\.io/pypa/manylinux_2_28_x86_64)@)(?<currentDigest>sha256:[0-9a-f]+)(?:\")"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "The Node.js the release bundle ships.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["(?:\"node\":\\s*\")(?<currentValue>[0-9.]+)(?:\")"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "description": "pi, the agent inside the VM, pinned in the image.",
      "customType": "regex",
      "managerFilePatterns": ["/^image\\/Containerfile$/"],
      "matchStrings": ["(?:ARG PI_VERSION=)(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@earendil-works/pi-coding-agent",
      "datasourceTemplate": "npm"
    }
  ]
}
