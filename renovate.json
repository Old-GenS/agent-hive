{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "A new major of anything here changes what the sandbox boots; ask on the dashboard, do not open a PR.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "libkrunfw 5.6.4 boots but breaks DNS in the VM (docs/RELEASING.md).",
      "matchPackageNames": ["containers/libkrunfw"],
      "allowedVersions": "<5.6.4"
    }
  ],
  "customManagers": [
    {
      "description": "libkrun is built from source; the tag is the pin and the build verifies its commit.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"libkrun\":\\s*\\{[^}]*?\"tag\":\\s*\"(?<currentValue>v?[0-9.]+)\""],
      "depNameTemplate": "containers/libkrun",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "libkrunfw: upstream's prebuilt kernel, one release asset per platform.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"libkrunfw\":\\s*\\{\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "containers/libkrunfw",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "passt lives on passt.top, not GitHub; its tags are dated snapshots.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"passt\":\\s*\\{[^}]*?\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "passt",
      "packageNameTemplate": "https://passt.top/passt",
      "datasourceTemplate": "git-tags"
    },
    {
      "description": "The Rust toolchain the native pieces are built with.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"rust\":\\s*\"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "The pinned manylinux container the native build runs in (digest-pinned).",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": [
        "\"buildImage\":\\s*\"(?<depName>quay\\.io/pypa/manylinux_2_28_x86_64)@(?<currentDigest>sha256:[0-9a-f]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "The Node.js the release bundle ships.",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.json$/"],
      "matchStrings": ["\"node\":\\s*\"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "description": "pi, the agent inside the VM, pinned in the image.",
      "customType": "regex",
      "managerFilePatterns": ["/^image\\/Containerfile$/"],
      "matchStrings": ["ARG PI_VERSION=(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "@earendil-works/pi-coding-agent",
      "datasourceTemplate": "npm"
    }
  ]
}
