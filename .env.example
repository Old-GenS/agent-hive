# Agent Hive configuration. Generate a token with: openssl rand -hex 32
API_TOKEN=

# At least one provider key. Only the key of the provider a task uses enters its sandbox.
DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Defaults (provider: first one with a key; model: a per-provider default)
# DEFAULT_PROVIDER=deepseek
# DEFAULT_MODEL=deepseek-v4-pro
# DEFAULT_THINKING=low

# Finished runs older than this many days are deleted at startup and every 6 hours; 0 keeps them.
# HIVE_RUN_RETENTION_DAYS=14

# OpenRouter provider routing, as JSON. Default prefers fp16/bf16/fp8 endpoints; order/only win.
# HIVE_OPENROUTER_ROUTING={"quantizations":["fp16","bf16","fp8"]}

# Sandboxes. HIVE_RUNTIME=auto uses the libkrun microVM when /dev/kvm, libkrun, pasta, the
# launcher and the rootfs are available; HIVE_RUNTIME=libkrun requires them.
# Keep MAX_CONCURRENT_SESSIONS x HIVE_SANDBOX_MEMORY well under the host's RAM.
# HIVE_RUNTIME=auto
# HIVE_SANDBOX_MEMORY=2048m
# HIVE_SANDBOX_CPUS=1
# HIVE_STALL_MIN=15
# Shared /root/.cache for the agent (Playwright browsers, npm, pip, corepack), kept between runs.
# HIVE_VM_CACHE=/home/you/.cache/agent-hive/vm-cache
# MAX_CONCURRENT_SESSIONS=2
# SESSION_IDLE_TIMEOUT_MS=1800000

# Identity for the agent's commits
# GIT_AUTHOR_NAME=agent-hive
# GIT_AUTHOR_EMAIL=agent-hive@users.noreply.github.com

# How the server clones and pushes github.com repos: https (the server's gh login) or ssh (deploy keys)
# HIVE_GIT_PROTOCOL=https

# Listen address (keep 127.0.0.1 behind a tunnel or reverse proxy; 0.0.0.0 only on a trusted LAN,
# since it's plain HTTP)
# HOST=127.0.0.1
# PORT=8080
