# Agent Hive configuration. Generate a token with: openssl rand -hex 32
API_TOKEN=

# At least one provider key. Only the key of the provider a task uses enters its sandbox.
DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Defaults (provider: first one with a key; model: a per-provider default)
# DEFAULT_PROVIDER=deepseek
# DEFAULT_MODEL=deepseek-v4-pro
# DEFAULT_THINKING=low

# Sandboxes. HIVE_RUNTIME=auto uses krun (microVM) when /dev/kvm and krun are available.
# Keep MAX_CONCURRENT_SESSIONS x HIVE_SANDBOX_MEMORY well under the host's RAM.
# HIVE_RUNTIME=auto
# HIVE_SANDBOX_MEMORY=1g
# HIVE_SANDBOX_CPUS=1
# MAX_CONCURRENT_SESSIONS=2
# SESSION_IDLE_TIMEOUT_MS=1800000

# Identity for the agent's commits
# GIT_AUTHOR_NAME=agent-hive
# GIT_AUTHOR_EMAIL=agent-hive@users.noreply.github.com

# Listen address (keep 127.0.0.1 behind a tunnel or reverse proxy)
# HOST=127.0.0.1
# PORT=8080
